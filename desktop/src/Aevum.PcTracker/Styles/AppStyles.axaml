<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Aevum-Design: dieselben Markenfarben wie die Android-App (Lavendel/Teal auf
       tiefem Dunkelblau). Alle Ressourcen liegen in App.axaml; hier werden sie
       nur verwendet (DynamicResource → robust über alle Scopes). -->

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.metric">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.section-label">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,9" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#BCB2FF" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#9080F2" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#3A326B" />
    <Setter Property="Foreground" Value="#9491A5" />
  </Style>

  <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,9" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#232848" />
  </Style>

  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="#7B4A4A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="Padding" Value="16,9" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2A1620" />
    <Setter Property="Foreground" Value="#FFB4B4" />
  </Style>

  <Style Selector="Button.chip">
    <Setter Property="Padding" Value="13,6" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.chip /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="13,6" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#232848" />
  </Style>
  <Style Selector="Button.chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2D3260" />
  </Style>

  <Style Selector="Button.nav">
    <!-- Volle Sidebar-Breite: sonst ist die Klickfläche nur so breit wie der Text. -->
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,11" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#151936" />
  </Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- Aufnahme-Puls (Dashboard „Jetzt“): weiches Atmen von Glow und Punkt -->
  <Style Selector="Border.pulseGlow">
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="INFINITE" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.15" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.6" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.pulseDot">
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="INFINITE" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.35" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- PC 1.5.0: Aufzeichnung „ganz deutlich sichtbar — mit Farbe und Schimmer"
       (Devon). Drei Bausteine: kräftiger Türkis-Rahmen (liveFrame), gefülltes
       RECORDING-Badge (recBadge) und ein wandernder Licht-Schimmer, der über
       die Karte zieht (shimmer; das Element bringt sein eigenes
       TranslateTransform mit, hier lebt nur die Endlos-Animation). -->
  <Style Selector="Border.liveFrame">
    <Setter Property="BorderBrush" Value="#5EEAD4" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.recBadge">
    <Setter Property="Background" Value="#5EEAD4" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="9,3" />
  </Style>
  <Style Selector="Border.shimmer">
    <Style.Animations>
      <Animation Duration="0:0:2.4" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="TranslateTransform.X" Value="-340" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="TranslateTransform.X" Value="1400" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
