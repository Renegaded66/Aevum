<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aevum.PcTracker.ViewModels"
             x:Class="Aevum.PcTracker.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,24,28,28" Spacing="16">
      <StackPanel Spacing="2">
        <TextBlock Text="{DynamicResource s.hist_title}" Classes="h1" />
        <TextBlock Text="{Binding SummaryText}" Classes="muted" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="12">
        <ComboBox SelectedIndex="{Binding RangeIndex, Mode=TwoWay}" MinWidth="160">
          <ComboBoxItem Content="{DynamicResource s.hist_today}" />
          <ComboBoxItem Content="{DynamicResource s.hist_7}" />
          <ComboBoxItem Content="{DynamicResource s.hist_30}" />
          <ComboBoxItem Content="{DynamicResource s.hist_all}" />
        </ComboBox>
      </StackPanel>

      <Border Classes="card" IsVisible="{Binding IsEmpty}">
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="{DynamicResource s.hist_empty}" />
      </Border>

      <ItemsControl ItemsSource="{Binding Days}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DayGroupViewModel">
            <Border Classes="card" Margin="0,0,0,12">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Header}" Classes="h2" />
                  <TextBlock Grid.Column="1" Text="{Binding Summary}" Classes="muted" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Sessions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionRowViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,4" ColumnSpacing="10">
                        <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock>
                            <Run Text="{Binding Title}" FontWeight="SemiBold" />
                            <Run Text=" · " Foreground="#9491A5" />
                            <Run Text="{Binding Subtitle}" Foreground="#CAC8D8" />
                          </TextBlock>
                          <TextBlock Text="{Binding TimeText}" Classes="muted" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                        <!-- PC 1.5.0: Aufzeichnung entfernen — zweistufig (Klick → „Ja/Nein") -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                          <Button Classes="icon" Content="✕" Command="{Binding RequestDeleteCommand}"
                                  IsVisible="{Binding !ConfirmDeleteVisible}"
                                  ToolTip.Tip="{DynamicResource s.hist_delete}"
                                  Foreground="#9491A5" />
                          <TextBlock Text="{DynamicResource s.hist_delete_q}" Classes="muted"
                                     VerticalAlignment="Center" IsVisible="{Binding ConfirmDeleteVisible}" />
                          <Button Classes="danger" Content="{DynamicResource s.hist_delete_yes}"
                                  Command="{Binding ConfirmDeleteCommand}" IsVisible="{Binding ConfirmDeleteVisible}"
                                  Padding="11,5" FontSize="12" />
                          <Button Classes="ghost" Content="{DynamicResource s.hist_delete_no}"
                                  Command="{Binding CancelDeleteCommand}" IsVisible="{Binding ConfirmDeleteVisible}"
                                  Padding="11,5" FontSize="12" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
