<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aevum.PcTracker.ViewModels"
             x:Class="Aevum.PcTracker.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,24,28,28" Spacing="16">
      <StackPanel Spacing="2">
        <TextBlock Text="{DynamicResource s.set_title}" Classes="h1" />
        <TextBlock Text="{DynamicResource s.set_subtitle}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Text="{DynamicResource s.set_tracking}" Classes="section-label" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{DynamicResource s.set_idle_label}" FontWeight="SemiBold" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="{DynamicResource s.set_idle_desc}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IdleEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                          OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IdleEnabled}">
            <TextBlock Text="{DynamicResource s.set_idle_after_label}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" MinWidth="160" ItemsSource="{Binding IdleOptions}"
                      SelectedItem="{Binding SelectedIdleOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:IdleMinuteOptionViewModel">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{DynamicResource s.set_threshold_label}" FontWeight="SemiBold" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="{DynamicResource s.set_threshold_desc}" />
            </StackPanel>
            <ComboBox Grid.Column="1" MinWidth="160" ItemsSource="{Binding ThresholdOptions}"
                      SelectedItem="{Binding SelectedThreshold, Mode=TwoWay}" VerticalAlignment="Center">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ThresholdOptionViewModel">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Text="{DynamicResource s.set_data}" Classes="section-label" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{DynamicResource s.set_retention_label}" FontWeight="SemiBold" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="{DynamicResource s.set_retention_desc}" />
            </StackPanel>
            <ComboBox Grid.Column="1" MinWidth="160" ItemsSource="{Binding RetentionOptions}"
                      SelectedItem="{Binding SelectedRetention, Mode=TwoWay}" VerticalAlignment="Center">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RetentionOptionViewModel">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{DynamicResource s.set_folder_label}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding DataFolderText}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="{DynamicResource s.set_open}"
                    Command="{Binding OpenDataFolderCommand}" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{DynamicResource s.set_delete_label}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ClearHint}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Classes="danger" Content="{DynamicResource s.set_delete_btn}" Command="{Binding ClearHistoryCommand}" />
              <Button Classes="ghost" Content="{DynamicResource s.common_cancel}" Command="{Binding CancelClearCommand}"
                      IsVisible="{Binding ClearConfirmVisible}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Text="{DynamicResource s.set_startup}" Classes="section-label" />
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding AutostartSupported}">
            <StackPanel Spacing="2">
              <TextBlock Text="{DynamicResource s.set_autostart_label}" FontWeight="SemiBold" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="{DynamicResource s.set_autostart_desc}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Autostart, Mode=TwoWay}" VerticalAlignment="Center"
                          OnContent="" OffContent="" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{DynamicResource s.set_startmin_label}" FontWeight="SemiBold" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="{DynamicResource s.set_startmin_desc}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartMinimized, Mode=TwoWay}" VerticalAlignment="Center"
                          OnContent="" OffContent="" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource s.upd_title}" Classes="section-label" />
          <TextBlock Text="{Binding UpdateCurrentText}" Classes="muted" />
          <TextBlock Text="{DynamicResource s.upd_auto}" Classes="muted" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="ghost" Content="{DynamicResource s.upd_check}"
                    Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding !UpdateBusy}" />
            <Button Classes="primary" Content="{DynamicResource s.upd_download}"
                    Command="{Binding DownloadUpdateCommand}"
                    IsVisible="{Binding UpdateDownloadVisible}" IsEnabled="{Binding !UpdateBusy}" />
            <Button Classes="ghost" Content="{DynamicResource s.upd_open}"
                    Command="{Binding OpenReleasePageCommand}"
                    IsVisible="{Binding UpdateManualVisible}" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="{DynamicResource s.upd_keep}" />
          <ProgressBar Value="{Binding UpdateProgress}" Minimum="0" Maximum="100"
                       Height="6" IsVisible="{Binding UpdateProgressVisible}" />
          <TextBlock Text="{Binding UpdateStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <StackPanel Spacing="4" IsVisible="{Binding UpdateNotesVisible}">
            <TextBlock Text="{DynamicResource s.upd_notes}" Classes="muted" FontSize="12" />
            <ScrollViewer MaxHeight="140">
              <TextBlock Text="{Binding UpdateDetail}" Classes="muted" TextWrapping="Wrap" />
            </ScrollViewer>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Text="{DynamicResource s.set_about}" Classes="section-label" />
          <TextBlock Text="{Binding VersionText}" />
          <TextBlock TextWrapping="Wrap" Classes="muted"
                     Text="{DynamicResource s.set_about_desc}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
