<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aevum.PcTracker.ViewModels"
        xmlns:v="using:Aevum.PcTracker.Views"
        x:Class="Aevum.PcTracker.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Aevum PC-Tracker"
        Width="1120" Height="760" MinWidth="920" MinHeight="640"
        Icon="/Assets/aevum-256.png"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterScreen">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:DashboardViewModel">
      <v:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="vm:RulesViewModel">
      <v:RulesView />
    </DataTemplate>
    <DataTemplate DataType="vm:HistoryViewModel">
      <v:HistoryView />
    </DataTemplate>
    <DataTemplate DataType="vm:PairingViewModel">
      <v:PairingView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <v:SettingsView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="248,*">
    <Border Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="22,26,22,18" Spacing="3">
          <TextBlock Text="Aevum" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
          <TextBlock Text="PC-Tracker" Classes="muted" FontSize="13" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="14,14,14,18" Classes="card" Padding="16">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="0,3,0,0" Fill="{Binding StatusDotBrush}" />
              <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="13"
                         TextWrapping="Wrap" MaxWidth="160" />
            </StackPanel>
            <Button Classes="ghost"
                    Command="{Binding TogglePauseCommand}"
                    Content="{Binding PauseButtonText}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <TextBlock Text="{Binding VersionText}" Classes="muted" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding NavItems}" Margin="12,0,12,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItemViewModel">
              <Button Classes="nav"
                      Classes.active="{Binding IsSelected}"
                      Command="{Binding SelectCommand}"
                      Margin="0,2">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Ellipse Width="8" Height="8" Fill="{Binding IndicatorBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontSize="14"
                             Margin="12,0,8,0" />
                  <Ellipse Grid.Column="2" Width="8" Height="8" Fill="#FFC85C" VerticalAlignment="Center"
                           IsVisible="{Binding HasBadge}" ToolTip.Tip="{Binding BadgeTooltip}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <!-- Auf jeder Seite oben rechts: Sync-Status mit Aktualisieren + Sprach-Flagge -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                  Margin="0,14,20,0">
        <Border Classes="pill" Padding="14,6" ToolTip.Tip="{DynamicResource s.sync_hint}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="8" Height="8" CornerRadius="4" Background="{Binding SyncDotBrush}"
                    VerticalAlignment="Center" />
            <TextBlock Text="{Binding SyncStatusText}" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="·" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SyncPhoneText}" FontSize="12" Classes="muted"
                       VerticalAlignment="Center" />
            <Button Classes="icon" Padding="6,1" Content="↻" Margin="2,0,0,0"
                    ToolTip.Tip="{DynamicResource s.common_refresh}"
                    Command="{Binding RefreshCurrentCommand}" />
          </StackPanel>
        </Border>
        <Button Classes="ghost" Padding="9,5"
                Command="{Binding ToggleLanguageCommand}"
                ToolTip.Tip="{DynamicResource s.language_tooltip}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <!-- Deutsch: schwarz-rot-gold gezeichnet (Emoji-Flaggen fehlen unter Windows) -->
            <Border Width="18" Height="12" CornerRadius="2" ClipToBounds="True" IsVisible="{Binding IsGerman}">
              <StackPanel>
                <Border Height="4" Background="#1A1A1A" />
                <Border Height="4" Background="#DD0000" />
                <Border Height="4" Background="#FFCE00" />
              </StackPanel>
            </Border>
            <!-- Englisch: stilisierte Union-Jack-Flagge -->
            <Border Width="18" Height="12" CornerRadius="2" ClipToBounds="True" IsVisible="{Binding !IsGerman}">
              <Grid>
                <Border Background="#012169" />
                <Border Height="4" Background="White" VerticalAlignment="Center" />
                <Border Width="4" Background="White" HorizontalAlignment="Center" />
                <Border Height="2" Background="#C8102E" VerticalAlignment="Center" />
                <Border Width="2" Background="#C8102E" HorizontalAlignment="Center" />
              </Grid>
            </Border>
            <TextBlock Text="{Binding LanguageLabel}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>

      <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
    </Grid>
  </Grid>
</Window>
