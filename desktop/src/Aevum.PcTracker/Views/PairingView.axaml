<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aevum.PcTracker.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Aevum.PcTracker.Views.PairingView"
             x:DataType="vm:PairingViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,24,28,28" Spacing="16">
      <StackPanel Spacing="2">
        <TextBlock Text="{DynamicResource s.pair_title}" Classes="h1" />
        <TextBlock Text="{DynamicResource s.pair_subtitle}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Verbindungsstatus, deutlich sichtbar -->
      <Border Classes="card" Padding="18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
          <Border Width="44" Height="44" CornerRadius="22"
                  Background="{DynamicResource SurfaceVariantBrush}" VerticalAlignment="Center">
            <TextBlock Text="📱" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="pulseDot" Width="9" Height="9" CornerRadius="5" Background="#5EEAD4"
                      VerticalAlignment="Center" IsVisible="{Binding IsConnected}" />
              <Border Width="9" Height="9" CornerRadius="5" Background="#9491A5"
                      VerticalAlignment="Center" IsVisible="{Binding !IsConnected}" />
              <TextBlock Text="{Binding ServerStatusText}" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="{Binding AddressText}" Classes="muted"
                       FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap" />
            <TextBlock Text="{Binding LastAccessText}" Classes="muted" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="{DynamicResource s.pair_how_title}" Classes="section-label" />
          <StackPanel Spacing="6">
            <TextBlock TextWrapping="Wrap" Text="{DynamicResource s.pair_step1}" />
            <TextBlock TextWrapping="Wrap" Text="{DynamicResource s.pair_step2}" />
            <TextBlock TextWrapping="Wrap" Text="{DynamicResource s.pair_step3}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{DynamicResource s.pair_mode_label}" Classes="section-label" />
              <TextBlock Text="{DynamicResource s.pair_mode_desc}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding PairingActive, Mode=TwoWay}" VerticalAlignment="Center"
                          OnContent="" OffContent="" />
          </Grid>

          <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="12" Padding="20,16">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
              <TextBlock Text="{DynamicResource s.pair_code_label}" Classes="section-label" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding CodeText}" FontSize="44" FontWeight="Bold" LetterSpacing="4"
                         Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
              <TextBlock Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap"
                         Text="{DynamicResource s.pair_code_hint}" />
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="ghost" Content="{DynamicResource s.pair_new_code}" Command="{Binding RotateCodeCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="{DynamicResource s.pair_security}" Classes="section-label" />
          <TextBlock TextWrapping="Wrap" Classes="muted"
                     Text="{DynamicResource s.pair_security_text}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="danger" Content="{DynamicResource s.pair_reset}" Command="{Binding ResetAccessCommand}" />
            <Button Classes="ghost" Content="{DynamicResource s.common_cancel}" Command="{Binding CancelResetCommand}"
                    IsVisible="{Binding ResetConfirmVisible}" />
          </StackPanel>
          <TextBlock Text="{Binding ResetHintText}" Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding ResetHintText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <TextBlock TextWrapping="Wrap" Classes="muted"
                   Text="{DynamicResource s.pair_firewall}" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
