<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aevum.PcTracker.ViewModels"
             x:Class="Aevum.PcTracker.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,24,28,28" Spacing="16">
      <StackPanel Spacing="2">
        <TextBlock Text="Dashboard" Classes="h1" />
        <TextBlock Text="Live-Überblick über die PC-Aufzeichnung" Classes="muted" />
      </StackPanel>

      <Border Classes="card" IsVisible="{Binding !ProbeAvailable}">
        <TextBlock TextWrapping="Wrap" Classes="muted"
                   Text="Die PC-Aufzeichnung läuft nur unter Windows. Diese Oberfläche läuft bereits — auf deinem Windows-PC wird sie Programme erkennen und an Aevum auf dem Handy übertragen." />
      </Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Grid.Column="0" Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="GERADE JETZT" Classes="section-label" />
            <StackPanel Orientation="Horizontal" Spacing="14">
              <TextBlock Text="{Binding NowIcon}" FontSize="34" VerticalAlignment="Center" />
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding NowTitle}" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="{Binding NowDetails}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="HEUTE" Classes="section-label" />
            <StackPanel Orientation="Horizontal" Spacing="18">
              <StackPanel>
                <TextBlock Text="{Binding TodayCountText}" Classes="metric" />
                <TextBlock Text="Aufzeichnungen" Classes="muted" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{Binding TodayTotalText}" Classes="metric" />
                <TextBlock Text="Gesamtdauer" Classes="muted" />
              </StackPanel>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding TopBars}" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BarRowViewModel">
                  <Grid ColumnDefinitions="Auto,110,*" Margin="0,3">
                    <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Border Width="{Binding BarWidth}" Height="8" CornerRadius="4"
                              Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding DurationText}" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="LETZTE AUFZEICHNUNGEN" Classes="section-label" />
          <TextBlock Text="Heute wurde noch nichts aufgezeichnet." Classes="muted"
                     IsVisible="{Binding !Recent.Count}" />
          <ItemsControl ItemsSource="{Binding Recent}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SessionRowViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,5">
                  <TextBlock Text="{Binding Icon}" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock>
                      <Run Text="{Binding Title}" FontWeight="SemiBold" />
                      <Run Text=" · " Foreground="#9491A5" />
                      <Run Text="{Binding Subtitle}" Foreground="#CAC8D8" />
                    </TextBlock>
                    <TextBlock Text="{Binding TimeText}" Classes="muted" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontWeight="SemiBold"
                             VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="VERBINDUNG ZUM HANDY" Classes="section-label" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding PairingDotBrush}" />
            <TextBlock Text="{Binding PairingStatusText}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding PairingAddressText}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Die Übertragung läuft nur im Heimnetz: Aevum auf dem Handy ruft die Daten direkt von diesem PC ab — nichts geht ins Internet." />
          <Button Classes="ghost" Content="Kopplung einrichten" Command="{Binding OpenPairingCommand}"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
