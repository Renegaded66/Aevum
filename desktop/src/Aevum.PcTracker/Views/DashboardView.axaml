<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aevum.PcTracker.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Aevum.PcTracker.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,24,28,28" Spacing="16">
      <StackPanel Spacing="2">
        <TextBlock Text="{DynamicResource s.dash_title}" Classes="h1" />
        <TextBlock Text="{DynamicResource s.dash_subtitle}" Classes="muted" />
      </StackPanel>

      <!-- PC 1.4.0: Was gerade auf dem HANDY aufgezeichnet wird — Live-Meldung
           der Aevum-App (alle wenigen Sekunden) mit Stop-/Pause-Steuerung.
           PC 1.5.0: Bei laufender Aufzeichnung deutlich markiert — Türkis-
           Rahmen, RECORDING-Badge und wandernder Schimmer. -->
      <Border Classes="card" Padding="22" IsVisible="{Binding PhoneLiveVisible}"
              Classes.liveFrame="{Binding PhoneLiveActive}">
        <Grid>
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
            <Grid Width="66" Height="66" VerticalAlignment="Center">
              <Border Classes="pulseGlow" Width="60" Height="60" CornerRadius="30"
                      Background="#5EEAD4" Opacity="0.15" IsVisible="{Binding PhoneLiveActive}" />
              <Border Width="54" Height="54" CornerRadius="27"
                      Background="{DynamicResource SurfaceVariantBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding PhoneLiveIcon}" FontSize="26"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="recBadge" IsVisible="{Binding PhoneLiveActive}" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource s.plive_badge}" FontSize="11" FontWeight="Bold"
                             Foreground="#0E1424" />
                </Border>
                <TextBlock Text="{DynamicResource s.plive_title}" Classes="section-label" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding PhoneLiveTitle}" FontSize="23" FontWeight="Bold"
                         TextWrapping="Wrap" />
              <!-- PC 1.5.2: große tickende Dauer der Handy-Aufzeichnung. -->
              <TextBlock Text="{Binding PhoneTimerText}" FontSize="34" FontWeight="Bold"
                         FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"
                         Foreground="#5EEAD4"
                         IsVisible="{Binding PhoneTimerText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="{Binding PhoneLiveLine}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding PhoneLiveHint}" Classes="muted" FontSize="12"
                         TextWrapping="Wrap" />
              <!-- Diagnose/Transparenz: zeigt live, wie frisch die letzte Handy-Meldung ist. -->
              <TextBlock Text="{Binding PhoneLastSeenText}" Classes="muted" FontSize="11"
                         IsVisible="{Binding PhoneLastSeenText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="ghost" Content="{Binding PhonePauseResumeLabel}"
                    Command="{Binding PhonePauseResumeCommand}" IsEnabled="{Binding !PhoneLiveStale}"
                    VerticalAlignment="Center" />
            <Button Grid.Column="3" Classes="danger" Content="{DynamicResource s.plive_stop}"
                    Command="{Binding PhoneStopCommand}" IsEnabled="{Binding !PhoneLiveStale}"
                    VerticalAlignment="Center" />
          </Grid>
          <!-- Schimmer: zieht als weicher Lichtstreifen über die Karte, solange
               die Handy-Aufzeichnung läuft (reine Deko, klickt nicht). -->
          <Border CornerRadius="14" ClipToBounds="True" IsHitTestVisible="False"
                  IsVisible="{Binding PhoneLiveActive}">
            <Border Classes="shimmer" Width="170" HorizontalAlignment="Left" Opacity="0.55">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Color="#005EEAD4" Offset="0" />
                  <GradientStop Color="#3A5EEAD4" Offset="0.5" />
                  <GradientStop Color="#005EEAD4" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Border.RenderTransform>
                <TranslateTransform X="-340" />
              </Border.RenderTransform>
            </Border>
          </Border>
        </Grid>
      </Border>

      <!-- Live-Karte: was gerade aufgezeichnet wird (Puls-Animation bei Aufnahme).
           PC 1.5.0: Bei laufender Aufzeichnung deutlich markiert (Rahmen, Badge,
           Schimmer) — „oben sollte das wirklich ganz deutlich sichtbar sein". -->
      <Border Classes="card" Padding="22" Classes.liveFrame="{Binding IsRecording}">
        <Grid>
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
            <Grid Width="66" Height="66" VerticalAlignment="Center">
              <Border Classes="pulseGlow" Width="66" Height="66" CornerRadius="33"
                      Background="#5EEAD4" Opacity="0.15" IsVisible="{Binding IsRecording}" />
              <Border Width="54" Height="54" CornerRadius="27"
                      Background="{DynamicResource SurfaceVariantBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding NowIcon}" FontSize="26"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="recBadge" IsVisible="{Binding IsRecording}" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource s.dash_rec_badge}" FontSize="11" FontWeight="Bold"
                             Foreground="#0E1424" />
                </Border>
                <Border Classes="pulseDot" Width="9" Height="9" CornerRadius="5"
                        Background="#5EEAD4" VerticalAlignment="Center"
                        IsVisible="{Binding IsRecording}" />
                <TextBlock Text="{Binding NowLabel}" Classes="section-label"
                           Foreground="{Binding NowLabelBrush}" VerticalAlignment="Center"
                           IsVisible="{Binding !IsRecording}" />
              </StackPanel>
              <TextBlock Text="{Binding NowTitle}" FontSize="23" FontWeight="Bold"
                         TextWrapping="Wrap" />
              <!-- PC 1.5.2: große tickende Dauer der PC-Aufzeichnung. -->
              <TextBlock Text="{Binding NowTimerText}" FontSize="34" FontWeight="Bold"
                         FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"
                         Foreground="#5EEAD4"
                         IsVisible="{Binding NowTimerText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="{Binding NowLine}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <!-- PC 1.3.0: Stop-Knopf — beendet die manuell gestartete Aktivität sofort -->
            <Button Grid.Column="2" Classes="danger" Content="{DynamicResource s.start_stop}"
                    Command="{Binding StopSessionCommand}" IsVisible="{Binding IsManualActive}"
                    VerticalAlignment="Center" />
          </Grid>
          <!-- Schimmer bei laufender PC-Aufzeichnung (siehe oben). -->
          <Border CornerRadius="14" ClipToBounds="True" IsHitTestVisible="False"
                  IsVisible="{Binding IsRecording}">
            <Border Classes="shimmer" Width="170" HorizontalAlignment="Left" Opacity="0.55">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Color="#005EEAD4" Offset="0" />
                  <GradientStop Color="#3A5EEAD4" Offset="0.5" />
                  <GradientStop Color="#005EEAD4" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Border.RenderTransform>
                <TranslateTransform X="-340" />
              </Border.RenderTransform>
            </Border>
          </Border>
        </Grid>
      </Border>

      <!-- Aktivität starten (PC 1.3.0): synchronisierte Aktivitäten aus Aevum,
           sofort oder mit Vorlaufzeit — analog zum Start auf dem Handy. -->
      <Border Classes="card" Padding="22,18">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource s.start_title}" Classes="section-label" />
          <TextBlock Text="{DynamicResource s.start_desc}" Classes="muted" TextWrapping="Wrap" />
          <!-- Nur bei ECHTER Pause (nicht beim Handy-Vorrang — der hat seinen
               eigenen Hinweis darunter; der Fix kam aus dem Xvfb-Test, wo
               beide Texte gleichzeitig erschienen). -->
          <TextBlock Text="{DynamicResource s.start_paused}" TextWrapping="Wrap"
                     Foreground="#FFC85C" IsVisible="{Binding IsPaused}" />
          <!-- PC 1.5.0: Handy-Vorrang — gleiche Stelle, Türkis statt Warn-Gelb -->
          <TextBlock Text="{DynamicResource s.start_phone_priority}" TextWrapping="Wrap"
                     Foreground="#5EEAD4" IsVisible="{Binding PhonePriorityActive}" />
          <!-- PC 1.6.0: Verifikations-Gate — der Start wartet auf eine frische
               Bestätigung des Handy-Stands (bzw. zeigt dezent, dass er frei ist). -->
          <TextBlock Text="{DynamicResource s.start_unverified}" TextWrapping="Wrap"
                     Foreground="#FFC85C" IsVisible="{Binding PhoneUnverifiedActive}" />
          <TextBlock Text="{DynamicResource s.start_phone_verified}" TextWrapping="Wrap"
                     Classes="muted" IsVisible="{Binding PhoneVerifiedFree}" />

          <!-- Vorlaufzeit läuft: Countdown + Abbrechen -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding HasPendingStart}">
            <TextBlock Text="{Binding PendingStartText}" FontWeight="SemiBold"
                       Foreground="#5EEAD4" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost" Content="{DynamicResource s.start_cancel}"
                    Command="{Binding CancelPendingStartCommand}" />
          </Grid>

          <!-- Aktivitäts-Chips (vom Handy synchronisiert) -->
          <ItemsControl ItemsSource="{Binding StartActivities}" IsEnabled="{Binding IsStartEnabled}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StartActivityOption">
                <!-- CommandParameter nötig: Avalonia übergibt den DataContext NICHT
                     automatisch — ohne ihn käme beim Command null an (Klick ohne Wirkung). -->
                <Button Classes="chip" Content="{Binding Label}" Command="{Binding SelectCommand}"
                        CommandParameter="{Binding}" Margin="0,0,8,8" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Start-Optionen der gewählten Aktivität: sofort oder mit Vorlaufzeit.
               PC 1.6.0: am Verifikations-Gate hängen — sonst wäre „Jetzt starten"
               bei nicht verifiziertem Handy-Stand klickbar, täte aber still nichts
               (Fund aus dem Xvfb-Smoke-Test). -->
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasSelectedStartActivity}"
                      IsEnabled="{Binding IsStartEnabled}">
            <TextBlock Text="{Binding SelectedStartActivity.Label}" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Classes="primary" Content="{DynamicResource s.start_now}"
                    Command="{Binding StartNowCommand}" />
            <Button Classes="ghost" Content="{DynamicResource s.start_in_5}"
                    Command="{Binding StartIn5Command}" />
            <Button Classes="ghost" Content="{DynamicResource s.start_in_15}"
                    Command="{Binding StartIn15Command}" />
            <Button Classes="ghost" Content="{DynamicResource s.start_in_30}"
                    Command="{Binding StartIn30Command}" />
          </StackPanel>

          <TextBlock Text="{DynamicResource s.start_hint}" Classes="muted" FontSize="12"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Allgemeine Aufzeichnung: eine Aktivität für „alles andere“ -->
      <Border Classes="card" Padding="22,18">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource s.gen_title}" Classes="section-label" />
              <TextBlock Text="{DynamicResource s.gen_desc}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GeneralEnabled}"
                          IsEnabled="{Binding HasGeneralActivities}"
                          OnContent="" OffContent="" VerticalAlignment="Center" />
          </Grid>
          <!-- PC 1.5.0: Die Aktivität ist JEDERZEIT wählbar — auch bevor der
               Schalter aktiviert wird (Devon: „bei Dashboard allgemeine
               Aufzeichnung auch schon die activity ausgewählt werden können
               bevor ich den schieberegler aktiviere, damit nicht direkt eine
               falsche activity aufgezeichnet wird"). -->
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding HasGeneralActivities}">
            <TextBlock Text="{DynamicResource s.gen_activity}" Classes="muted" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding GeneralActivities}"
                      SelectedItem="{Binding SelectedGeneralActivity}"
                      SelectionChanged="OnGeneralActivityChanged"
                      PlaceholderText="{DynamicResource s.gen_choose}"
                      HorizontalAlignment="Stretch" MinWidth="240">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:GeneralActivityOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <TextBlock Text="{DynamicResource s.gen_stops}" Classes="muted" FontSize="12"
                     IsVisible="{Binding GeneralEnabled}" TextWrapping="Wrap" />
          <TextBlock Text="{DynamicResource s.gen_empty}" Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding !HasGeneralActivities}" />
        </StackPanel>
      </Border>

      <!-- Heute + Dein Handy -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="{DynamicResource s.dash_tracking_today}" Classes="section-label" />
            <StackPanel Orientation="Horizontal" Spacing="26">
              <StackPanel>
                <TextBlock Text="{Binding TodayCountText}" Classes="metric" />
                <TextBlock Text="{DynamicResource s.dash_sessions}" Classes="muted" FontSize="11" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{Binding TodayTotalText}" Classes="metric" />
                <TextBlock Text="{DynamicResource s.dash_total_today}" Classes="muted" FontSize="11" />
              </StackPanel>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding TopBars}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BarRowViewModel">
                  <Grid ColumnDefinitions="Auto,120,*,Auto" ColumnSpacing="10" Margin="0,3">
                    <TextBlock Text="{Binding Icon}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                               FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="2" Height="8" CornerRadius="4" Background="#5EEAD4"
                            Opacity="0.75" Width="{Binding BarWidth}"
                            HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding DurationText}" Classes="muted"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="{DynamicResource s.dash_phone}" Classes="section-label" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="9" Height="9" CornerRadius="5" Background="{Binding PhoneDotBrush}"
                      VerticalAlignment="Center" />
              <TextBlock Text="{Binding PhoneStatusText}" FontWeight="SemiBold"
                         TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding PhoneDetailText}" Classes="muted" />
            <TextBlock Text="{DynamicResource s.dash_phone_hint}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PairingHintText}" Classes="muted" TextWrapping="Wrap" />
            <Button Classes="ghost" Content="{DynamicResource s.dash_setup}"
                    Command="{Binding OpenPairingCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Letzte Aufzeichnungen -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource s.dash_recent}" Classes="section-label" />
          <TextBlock Text="{DynamicResource s.dash_recent_empty}" Classes="muted"
                     IsVisible="{Binding !HasRecent}" />
          <ItemsControl ItemsSource="{Binding Recent}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SessionRowViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Margin="0,5">
                  <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock Text="{Binding Subtitle}" Classes="muted" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding TimeText}" Classes="muted"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontWeight="SemiBold"
                             VerticalAlignment="Center" MinWidth="64" TextAlignment="Right"
                             Foreground="{DynamicResource PrimaryBrush}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
