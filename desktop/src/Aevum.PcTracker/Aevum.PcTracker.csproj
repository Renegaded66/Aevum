<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: auf Windows als reine GUI-Anwendung gestartet — kein Konsolenfenster
         ("bestenfalls nur mit ui ohne shell"). Auf Linux (Tests/Build) bleibt es eine
         normale ausführbare Datei. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>Aevum.PcTracker</RootNamespace>
    <AssemblyName>AevumPcTracker</AssemblyName>
    <Version>1.5.1</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/aevum.ico</ApplicationIcon>
    <!-- Erlaubt den win-x64-Build auch von Linux aus (Cross-Publishing). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aevum.PcTracker.Core\Aevum.PcTracker.Core.csproj" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

</Project>
