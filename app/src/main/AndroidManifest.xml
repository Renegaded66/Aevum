<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- M9: Live Activity foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- M18.61: Digital Balance — Overlay-Sperre -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- M8: Health Connect -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />

    <!-- M8.1: Re-register geofences after boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        M12.2: PACKAGE_USAGE_STATS is a "protected permission" — it cannot be granted
        at runtime via requestPermissions(). The user must enable it manually in
        Settings → Apps → Special access → Usage access. Declaring the permission
        is required for the app to appear in the Usage-Access list. tools:ignore
        suppresses the lint warning that this permission is normally only granted
        to system apps.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- UsageStatsManager needs special app access, not a normal permission -->
    <!-- Health Connect permissions are handled at runtime via Health Connect SDK -->

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- M18.61g: Paket-Sichtbarkeit (Android 11+) — ohne <queries> sieht
         die App nur sich selbst + System-Apps. getApplicationLabel/
         getApplicationIcon werfen sonst NameNotFoundException für fast
         alle Apps → Paketname statt App-Name, kein Logo. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AevumApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aevum">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Aevum"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M18.61g-FIX 2: Vollbild-Sperr-Popup (Digital Balance). Eigene
             Activity statt Overlay — braucht KEINE Overlay-Berechtigung
             und drängt die gesperrte App zuverlässig in den Hintergrund.
             taskAffinity="" + singleInstance isolieren sie vom Task der
             gesperrten App; excludeFromRecents hält sie aus der
             App-Übersicht. -->
        <activity
            android:name=".domain.digital.BlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Aevum" />

        <!-- Hilt requires this meta-data for ViewModel injection -->
        <meta-data
            android:name="dagger.hilt.android.internal.ENTRY_POINT"
            android:value="true" />

        <receiver
            android:name=".automation.geofence.GeofenceBroadcastReceiver"
            android:exported="true" />

        <!-- M12.2: Activity Recognition (Fahrten)
             M18.43-CRITICAL-FIX: exported="true" ist PFLICHT! Google Play
             Services ist eine ANDERE App und sendet den Transition-Broadcast
             über den System-Broadcast. Mit exported="false" (vorher) wurde
             der Broadcast von GMS blockiert -> KEINE IN_VEHICLE-Events,
             keine Autofahrt-Erkennung, keine Trigger. Die Action ist
             GMS-spezifisch (com.google.android.gms.location.ACTION_ACTIVITY_TRANSITIONS),
             daher ist exported="true" hier sicher. -->
        <receiver
            android:name=".automation.activityrecognition.ActivityTransitionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.location.ACTION_ACTIVITY_TRANSITIONS" />
            </intent-filter>
        </receiver>

        <!-- M17.4: Initial-Activity-Snapshot Receiver — empfängt die ersten
             Activity-Samples nach Boot/App-Start, um zu erkennen, ob der
             User gerade IN_VEHICLE ist. exported=false weil nur lokale
             PendingIntents von der App selbst ankommen. -->
        <receiver
            android:name=".automation.activityrecognition.InitialActivityProbeReceiver"
            android:exported="false" />

        <receiver
            android:name=".automation.geofence.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- M13: Screen On/Off receiver for sleep heuristic (no Health Connect required) -->
        <receiver
            android:name=".automation.sleep.ScreenEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.SCREEN_OFF" />
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <service
            android:name=".automation.geofence.GeofenceForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- M18.66: Autofahrt-Erkennung über kontinuierlichen GPS-Stream.
             ForegroundService vom Typ "location" (Pflicht ab Android 14+,
             damit requestLocationUpdates im Hintergrund zuverlässig läuft).
             Wird gestartet, solange die Autofahrt-Erkennung aktiv ist. -->
        <service
            android:name=".automation.activityrecognition.DriveDetectionService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- M18.67: App-Aufzeichnung — erkennt getrackte Apps über die
             UsageStats-Event-API und startet/stoppt automatisch die
             zugeordnete Activity. ForegroundService vom Typ "specialUse"
             (kein GPS, kein Standort — nur App-Nutzungs-Events). -->
        <service
            android:name=".automation.apptracking.AppTrackingService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- M9: Live Activity foreground service -->
        <service
            android:name=".domain.liveactivity.LiveActivityService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- M18.19: Wechsel-Popup — transparente Dialog-Activity,
             wird aus der Live-Notification ("⇄ Wechseln") geöffnet. -->
        <activity
            android:name=".ui.screens.dashboard.SwitchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Aevum.Translucent"
            android:taskAffinity="com.d_drostes_apps.aevum.switch"
            android:launchMode="singleTask" />

        <!-- M18.61: Digital Balance — Sperr-Service (Overlay) -->
        <service
            android:name=".domain.digital.AppBlockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="digital_balance_app_limits" />
        </service>

    </application>

</manifest>