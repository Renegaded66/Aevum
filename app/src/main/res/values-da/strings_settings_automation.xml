    <string name="settings_privacy_title">Privatliv</string>
    <string name="settings_privacy_subtitle">Aevum kører helt lokalt. Dine data forlader aldrig din enhed — ingen servere, ingen konti og ingen analyse fra tredjeparter.</string>
    <string name="settings_privacy_local_processing">Lokal databehandling</string>
    <string name="settings_privacy_local_processing_body">• Alle registreringer, triggere og indstillinger ligger kun i appens database på din enhed.\n• Ingen data sendes til servere, ingen reklame-IDs bruges og ingen tracking-SDKs indgår.\n• Placerings- og aktivitetsdata bruges udelukkende til automatisk genkendelse.</string>
    <string name="settings_privacy_your_control">Din kontrol</string>
    <string name="settings_privacy_your_control_body">• Automatisk genkendelse er frivillig — hver kilde kan slås fra i indstillingerne.\n• Du kan til enhver tid oprette en backup, eksportere data eller slette alt.\n• Tilladelser (placering, aktivitet, notifikationer) kan du når som helst tilbagekalde i systemindstillingerne.</string>
    <string name="settings_privacy_delete_all">Slet alle data</string>
    <string name="settings_privacy_delete_all_desc">Fjerner permanent alle registreringer, triggere, mål og indstillinger fra denne enhed. Appen genstarter bagefter. Dette trin kan ikke fortrydes — opret først en backup.</string>
    <string name="settings_privacy_delete_confirm_title">Vil du virkelig slette alt?</string>
    <string name="settings_privacy_delete_confirm_body">Alle dine registreringer og indstillinger slettes endegyldigt. Vil du fortsætte?</string>
    <string name="settings_privacy_final_warning_title">Sidste advarsel</string>
    <string name="settings_privacy_final_warning_body">Dette er endegyldigt. Dine data kan ikke gendannes. Vil du virkelig slette?</string>
    <string name="settings_privacy_delete_yes">Ja, slet alt</string>
    <string name="settings_export_subtitle">Eksporter alle dine data som JSON-fil. Du kan åbne den i enhver app med JSON-understøttelse — perfekt til arkivering eller overførsel til andre værktøjer.</string>
    <string name="settings_export_all_json">Eksporter alle data som JSON</string>
    <string name="settings_export_all_json_desc">Opretter en komplet kopi af alle tabeller (aktiviteter, triggere, mål, vaner, gøremål, …) som én JSON-fil. Eksporten indeholder ingen adgangskoder eller loginoplysninger.</string>
    <string name="settings_export_start">Start eksport</string>
    <string name="settings_backup_subtitle">Tag en komplet sikkerhedskopi af din database og alle app-indstillinger som ZIP-fil — fx til Google Drive, din sky eller din computer. Nye dataområder medtages automatisk, så du når som helst kan skifte til en ny telefon.</string>
    <string name="settings_backup_create">Opret backup</string>
    <string name="settings_backup_create_desc">Opretter en ZIP-fil med hele din database (alle funktioner: mål, Digital Balance, detektorhistorik, tidslinjer, …) og alle indstillinger. Anbefaling: tag backup regelmæssigt, fx før opdateringer eller på rejser.</string>
    <string name="settings_backup_restore">Gendan backup</string>
    <string name="settings_backup_restore_desc">Vælger en tidligere oprettet ZIP-fil og gendanner alle data. Ældre backups konverteres automatisk. Appen genstarter bagefter; den aktuelle database gemmes først som sikkerhedskopi.</string>
    <string name="settings_backup_choose">Vælg backup</string>
    <string name="settings_backup_confirm_title">Gendan backup?</string>
    <string name="settings_backup_confirm_body">Ved gendannelse erstattes ALLE aktuelle data endegyldigt af backuppens indhold. Dette kan ikke fortrydes.</string>
    <string name="settings_backup_confirm_restore">Gendan</string>
