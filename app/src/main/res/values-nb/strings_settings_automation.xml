<resources>
    <string name="settings_privacy_title">Personvern</string>
    <string name="settings_privacy_subtitle">Aevum arbeider helt lokalt. Dataene dine forlater aldri enheten — det finnes ingen servere, ingen kontoer og ingen analyse fra tredjeparter.</string>
    <string name="settings_privacy_local_processing">Lokal databehandling</string>
    <string name="settings_privacy_local_processing_body">• Alle registreringer, triggere og innstillinger ligger kun i appens database på enheten din.\n• Ingen data sendes til servere, ingen reklame-ID-er brukes og ingen tracking-SDK-er er integrert.\n• Posisjons- og aktivitetsdata brukes utelukkende til automatisk gjenkjenning.</string>
    <string name="settings_privacy_your_control">Din kontroll</string>
    <string name="settings_privacy_your_control_body">• Automatisk gjenkjenning er frivillig — hver kilde kan slås av i innstillingene.\n• Du kan når som helst opprette en sikkerhetskopi, eksportere data eller slette alt.\n• Tillatelser (posisjon, aktivitet, varsler) kan du trekke tilbake når som helst i systeminnstillingene.</string>
    <string name="settings_privacy_delete_all">Slett alle data</string>
    <string name="settings_privacy_delete_all_desc">Fjerner permanent alle registreringer, triggere, mål og innstillinger fra denne enheten. Appen starter på nytt etterpå. Dette kan ikke angres — opprett en sikkerhetskopi først.</string>
    <string name="settings_privacy_delete_confirm_title">Virkelig slette alt?</string>
    <string name="settings_privacy_delete_confirm_body">Alle registreringene og innstillingene dine slettes permanent. Vil du fortsette?</string>
    <string name="settings_privacy_final_warning_title">Siste advarsel</string>
    <string name="settings_privacy_final_warning_body">Dette er endelig. Det finnes ingen måte å gjenopprette dataene på. Vil du virkelig slette?</string>
    <string name="settings_privacy_delete_yes">Ja, slett alt</string>
    <string name="settings_export_subtitle">Eksporter alle dataene dine som en JSON-fil. Du kan åpne den i enhver app som støtter JSON — perfekt for arkivering eller overføring til andre verktøy.</string>
    <string name="settings_export_all_json">Eksporter alle data som JSON</string>
    <string name="settings_export_all_json_desc">Oppretter en fullstendig kopi av alle tabellene (aktiviteter, triggere, mål, vaner, gjøremål, …) som én JSON-fil. Eksporten inneholder ingen passord eller påloggingsdata.</string>
    <string name="settings_export_start">Start eksport</string>
    <string name="settings_backup_subtitle">Sikkerhetskopier hele databasen og alle appinnstillingene som en ZIP-fil — for eksempel til Google Drive, skyen din eller datamaskinen din. Nye dataområder tas automatisk med, slik at du når som helst kan bytte til en ny telefon.</string>
    <string name="settings_backup_create">Opprett sikkerhetskopi</string>
    <string name="settings_backup_create_desc">Oppretter en ZIP-fil med hele databasen din (alle funksjoner: mål, Digital Balance, detektorhistorikk, tidslinjer, …) og alle innstillingene. Anbefaling: opprett sikkerhetskopi regelmessig, for eksempel før oppdateringer eller når du reiser.</string>
    <string name="settings_backup_restore">Gjenopprett sikkerhetskopi</string>
    <string name="settings_backup_restore_desc">Velger en tidligere opprettet ZIP-fil og gjenoppretter alle dataene. Eldre sikkerhetskopier migreres automatisk. Appen starter på nytt etterpå; den gjeldende databasen lagres først som sikkerhetskopi.</string>
    <string name="settings_backup_choose">Velg sikkerhetskopi</string>
    <string name="settings_backup_confirm_title">Gjenopprette sikkerhetskopi?</string>
    <string name="settings_backup_confirm_body">Ved gjenoppretting av sikkerhetskopien erstattes ALLE gjeldende data permanent med innholdet i sikkerhetskopien. Dette kan ikke angres.</string>
