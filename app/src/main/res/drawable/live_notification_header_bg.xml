<?xml version="1.0" encoding="utf-8"?>
<!--
    M18.23: Fancy Notification-Hintergrund mit Gradient + diagonalen Streifen.
    RemoteViews kann keine Compose-Drawables, aber Layer-List mit Shape-Drawables.
    Die Aktivitaetsfarbe wird zur Laufzeit per remoteViews.setInt(background, "setColorFilter", color) gesetzt.
    Das Pattern darueber ist ein halbtransparentes Diagonal-Stripe-Muster.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Basis-Farbe (wird zur Laufzeit gesetzt) -->
    <item android:id="@+id/notification_bg_base">
        <shape android:shape="rectangle">
            <solid android:color="#4CAF50" />
        </shape>
    </item>
    <!-- Diagonal-Stripe-Pattern (halbtransparent) -->
    <item android:id="@+id/notification_bg_pattern">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#FFFFFF" />
            <padding android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp" />
        </shape>
    </item>
</layer-list>