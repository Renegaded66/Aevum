<?xml version="1.0" encoding="utf-8"?>
<!--
    Legacy-Hintergrund für den nicht mehr verwendeten RemoteViews-Entwurf.
    Das aktuelle „Activity Signal“-Muster wird als kontraststarkes Bitmap in
    LiveActivityService erzeugt, damit es auf Android 12+ und OEM-System-UIs
    konsistent erscheint.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Basis-Farbe (wird zur Laufzeit gesetzt) -->
    <item android:id="@+id/notification_bg_base">
        <shape android:shape="rectangle">
            <solid android:color="#4CAF50" />
        </shape>
    </item>
    <!-- Diagonal-Stripe-Pattern (halbtransparent) -->
    <item android:id="@+id/notification_bg_pattern">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#FFFFFF" />
            <padding android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp" />
        </shape>
    </item>
</layer-list>