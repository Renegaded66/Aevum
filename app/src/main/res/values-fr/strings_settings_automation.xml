    <string name="settings_privacy_title">Confidentialité</string>
    <string name="settings_privacy_subtitle">Aevum travaille entièrement en local. Tes données ne quittent jamais ton appareil — il n\'y a ni serveurs, ni comptes, ni analyse par des tiers.</string>
    <string name="settings_privacy_local_processing">Traitement local des données</string>
    <string name="settings_privacy_local_processing_body">• Tous les enregistrements, déclencheurs et réglages ne se trouvent que dans la base de données de l\'application, sur ton appareil.\n• Aucune donnée n\'est envoyée à des serveurs, aucune ID publicitaire utilisée et aucun SDK de suivi intégré.\n• Les données de localisation et d\'activité ne servent qu\'à la détection automatique.</string>
    <string name="settings_privacy_your_control">Ton contrôle</string>
    <string name="settings_privacy_your_control_body">• La détection automatique est facultative — chaque source se désactive dans les réglages.\n• Tu peux à tout moment créer une sauvegarde, exporter les données ou tout supprimer.\n• Les autorisations (localisation, activité, notifications) se révoquent à tout moment dans les réglages système.</string>
    <string name="settings_privacy_delete_all">Supprimer toutes les données</string>
    <string name="settings_privacy_delete_all_desc">Retire définitivement de cet appareil tous les enregistrements, déclencheurs, objectifs et réglages. L\'application redémarre ensuite. Cette étape n\'est pas réversible — crée une sauvegarde au préalable.</string>
    <string name="settings_privacy_delete_confirm_title">Tout supprimer vraiment ?</string>
    <string name="settings_privacy_delete_confirm_body">Tous tes enregistrements et réglages seront supprimés de façon irrévocable. Veux-tu continuer ?</string>
    <string name="settings_privacy_final_warning_title">Dernier avertissement</string>
    <string name="settings_privacy_final_warning_body">C\'est définitif. Aucune possibilité de restaurer les données. Supprimer vraiment ?</string>
    <string name="settings_privacy_delete_yes">Oui, tout supprimer</string>
    <string name="settings_export_subtitle">Exporte toutes tes données dans un fichier JSON. Tu peux l\'ouvrir dans toute application compatible JSON — parfait pour l\'archivage ou pour transmettre à d\'autres outils.</string>
    <string name="settings_export_all_json">Exporter toutes les données en JSON</string>
    <string name="settings_export_all_json_desc">Crée une copie complète de toutes les tables (activités, déclencheurs, objectifs, habitudes, tâches, …) dans un fichier JSON. L\'export ne contient ni mots de passe ni identifiants.</string>
    <string name="settings_export_start">Lancer l\'export</string>
    <string name="settings_backup_subtitle">Sauvegarde ta base de données complète et tous les réglages de l\'application dans un fichier ZIP — p. ex. sur Google Drive, dans ton cloud ou sur ton ordinateur. Les nouvelles zones de données sont sauvegardées automatiquement, pour pouvoir changer de téléphone à tout moment.</string>
    <string name="settings_backup_create">Créer une sauvegarde</string>
    <string name="settings_backup_create_desc">Crée un fichier ZIP avec toute ta base de données (toutes les fonctions : objectifs, Digital Balance, historique du détecteur, Chronologies, …) et tous les réglages. Recommandé : faire une sauvegarde régulièrement, p. ex. avant les mises à jour ou en voyage.</string>
    <string name="settings_backup_restore">Restaurer une sauvegarde</string>
    <string name="settings_backup_restore_desc">Choisis un fichier ZIP créé au préalable et restaure toutes les données. Les sauvegardes plus anciennes sont migrées automatiquement. L\'application redémarre ensuite ; la base de données actuelle est déposée en sauvegarde au préalable.</string>
    <string name="settings_backup_choose">Choisir une sauvegarde</string>
    <string name="settings_backup_confirm_title">Importer la sauvegarde ?</string>
    <string name="settings_backup_confirm_body">En important la sauvegarde, TOUTES les données actuelles sont remplacées de façon irrévocable par le contenu de la sauvegarde. Ce processus n\'est pas réversible.</string>
    <string name="settings_backup_confirm_restore">Importer</string>
