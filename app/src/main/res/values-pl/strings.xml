    <!-- Windows app installation (short guide) -->
    <string name="pc_tracker_install_title">Instalowanie aplikacji Windows</string>
    <string name="pc_tracker_install_step1">1. Na komputerze otwórz: github.com/Renegaded66/Aevum/releases</string>
    <string name="pc_tracker_install_step2">2. Pobierz i rozpakuj plik AevumPcTracker-…-win-x64.zip (prawy przycisk → Wyodrębnij wszystko).</string>
    <string name="pc_tracker_install_step3">3. Uruchom AevumPcTracker.exe — Windows raz zapyta o zaporę, zezwól na dostęp.</string>
    <string name="pc_tracker_install_hint">Bez instalacji — wszystko jest w pliku ZIP. Aplikacja działa tylko w systemie Windows.</string>
    <string name="pc_tracker_install_open">Otwórz stronę pobierania</string>
    <string name="pc_tracker_autosync">Synchronizuj automatycznie w tle</string>
    <string name="pc_tracker_autosync_desc">Cicho pobiera nagrania, gdy ten komputer jest w tej samej sieci Wi-Fi. O błędach dowiesz się tylko przy synchronizacji ręcznej.</string>
