    <!-- Privacy / Export / Backup (DataSettingsScreens.kt) -->
    <string name="settings_privacy_title">Integritet</string>
    <string name="settings_privacy_subtitle">Aevum fungerar helt lokalt. Dina data lämnar aldrig din enhet — inga servrar, inga konton och ingen analys av tredje part.</string>
    <string name="settings_privacy_local_processing">Lokal databehandling</string>
    <string name="settings_privacy_local_processing_body">• Alla inspelningar, triggers och inställningar ligger bara i appens databas på din enhet.\n• Inga data skickas till servrar, inga annons-ID:n används och inga SDK:er för spårning ingår.\n• Plats- och aktivitetsdata används enbart för automatisk upptäckt.</string>
    <string name="settings_privacy_your_control">Din kontroll</string>
    <string name="settings_privacy_your_control_body">• Automatisk upptäckt är frivillig — varje källa kan stängas av i inställningarna.\n• Du kan när som helst skapa en backup, exportera data eller radera allt.\n• Behörigheter (plats, aktivitet, aviseringar) kan du när som helst återkalla i systeminställningarna.</string>
    <string name="settings_privacy_delete_all">Radera all data</string>
    <string name="settings_privacy_delete_all_desc">Tar bort alla inspelningar, triggers, mål och inställningar från den här enheten permanent. Appen startas om efteråt. Det här steget går inte att ångras — skapa en backup först.</string>
    <string name="settings_privacy_delete_confirm_title">Verkligen radera allt?</string>
    <string name="settings_privacy_delete_confirm_body">Alla dina inspelningar och inställningar raderas oåterkalleligt. Vill du fortsätta?</string>
    <string name="settings_privacy_final_warning_title">Sista varning</string>
    <string name="settings_privacy_final_warning_body">Det här är slutgiltigt. Det finns inget sätt att återställa data. Verkligen radera?</string>
    <string name="settings_privacy_delete_yes">Ja, radera allt</string>
    <string name="settings_export_subtitle">Exportera all din data som en JSON-fil. Du kan öppna den i vilken app som helst som stödjer JSON — perfekt för arkivering eller för att lämna över till andra verktyg.</string>
    <string name="settings_export_all_json">Exportera all data som JSON</string>
    <string name="settings_export_all_json_desc">Skapar en komplett kopia av alla tabeller (aktiviteter, triggers, mål, vanor, uppgifter, …) som en enskild JSON-fil. Exporten innehåller inga lösenord eller inloggningsuppgifter.</string>
    <string name="settings_export_start">Starta export</string>
    <string name="settings_backup_subtitle">Ta backup på hela databasen och alla appinställningar som en ZIP-fil — t.ex. till Google Drive, din molntjänst eller din dator. Nya dataområden tas alltid med automatiskt, så att du kan byta till en ny telefon när som helst.</string>
    <string name="settings_backup_create">Skapa backup</string>
    <string name="settings_backup_create_desc">Skapar en ZIP-fil med hela databasen (alla funktioner: mål, Digital Balance, detektorhistorik, tidslinjer, …) och alla inställningar. Rekommenderas: skapa en backup regelbundet, t.ex. före uppdateringar eller inför resor.</string>
    <string name="settings_backup_restore">Återställ backup</string>
    <string name="settings_backup_restore_desc">Väljer en ZIP-fil som skapats tidigare och återställer all data. Äldre backups migreras automatiskt. Appen startas om efteråt; den aktuella databasen sparas först som säkerhetskopia.</string>
    <string name="settings_backup_choose">Välj backup</string>
    <string name="settings_backup_confirm_title">Återställa backup?</string>
    <string name="settings_backup_confirm_body">Vid återställning av backupen ersätts ALL aktuell data oåterkalleligt av innehållet i backupen. Det här går inte att ångras.</string>
    <string name="settings_backup_confirm_restore">Återställ</string>
    <string name="settings_working">Arbetar …</string>

