    <!-- Privacy / Export / Backup (DataSettingsScreens.kt) -->
    <string name="settings_privacy_title">Privacy</string>
    <string name="settings_privacy_subtitle">Aevum works completely offline. Your data never leaves your device — no servers, no accounts, and no third-party analytics.</string>
    <string name="settings_privacy_local_processing">Local data processing</string>
    <string name="settings_privacy_local_processing_body">• All recordings, triggers and settings are stored only in the app database on your device.\n• No data is transmitted to servers, no advertising IDs are used, and no tracking SDKs are integrated.\n• Location and activity data is used exclusively for automatic detection.</string>
    <string name="settings_privacy_your_control">Your control</string>
    <string name="settings_privacy_your_control_body">• Automatic detection is voluntary — every source can be turned off in the settings.\n• You can create a backup, export data, or delete everything at any time.\n• Permissions (location, activity, notifications) can be revoked at any time in the system settings.</string>
    <string name="settings_privacy_delete_all">Delete all data</string>
    <string name="settings_privacy_delete_all_desc">Permanently removes all recordings, triggers, goals and settings from this device. The app will restart afterwards. This step cannot be undone — create a backup first.</string>
    <string name="settings_privacy_delete_confirm_title">Really delete everything?</string>
    <string name="settings_privacy_delete_confirm_body">All your recordings and settings will be deleted irreversibly. Do you want to continue?</string>
    <string name="settings_privacy_final_warning_title">Final warning</string>
    <string name="settings_privacy_final_warning_body">This is final. There is no way to restore the data. Really delete?</string>
    <string name="settings_privacy_delete_yes">Yes, delete everything</string>
    <string name="settings_export_subtitle">Export all your data as a JSON file. You can open it in any app that supports JSON — perfect for archiving or handing over to other tools.</string>
    <string name="settings_export_all_json">Export all data as JSON</string>
    <string name="settings_export_all_json_desc">Creates a complete copy of all tables (activities, triggers, goals, habits, todos, …) as a single JSON file. The export contains no passwords or credentials.</string>
    <string name="settings_export_start">Start export</string>
    <string name="settings_backup_subtitle">Back up your complete database as a ZIP file — e.g. to Google Drive, your cloud, or your computer. With the backup you can fully restore Aevum at any time.</string>
    <string name="settings_backup_create">Create backup</string>
    <string name="settings_backup_create_desc">Creates a ZIP file with your entire database. Recommended: create a backup regularly, e.g. before updates or when traveling.</string>
    <string name="settings_backup_restore">Restore backup</string>
    <string name="settings_backup_restore_desc">Selects a previously created ZIP file and restores all data. The app will restart automatically afterwards. The current database is saved as a safety copy first.</string>
    <string name="settings_backup_choose">Choose backup</string>
    <string name="settings_backup_confirm_title">Restore backup?</string>
    <string name="settings_backup_confirm_body">Restoring the backup will irreversibly replace ALL current data with the backup contents. This action cannot be undone.</string>
    <string name="settings_backup_confirm_restore">Restore</string>
    <string name="settings_working">Working …</string>

